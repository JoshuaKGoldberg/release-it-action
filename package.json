{
	"name": "release-it-action",
	"version": "0.6.5",
	"description": "Runs release-it as a GitHub Action, with handling for semantic releases and protected branches. 📤",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/release-it-action.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./lib/index.js"
	},
	"main": "lib/index.js",
	"files": [
		"lib/",
		"!lib/action/"
	],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"build:release": "rm -rf dist && ncc build src/action/index.ts -o dist",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:knip:production": "knip --production",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"prepublishOnly": "rm -rf lib && pnpm build",
		"test": "vitest",
		"tsc": "tsc --noEmit"
	},
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"@octokit/types": "^18.0.0",
		"execa": "^10.0.0",
		"shlex": "^3.0.0",
		"should-semantic-release": "^0.3.5"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@release-it/conventional-changelog": "12.0.2",
		"@types/node": "26.6.5",
		"@vercel/ncc": "0.45.0",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"create-typescript-app": "2.87.18",
		"cspell": "10.5.2",
		"eslint": "10.15.0",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.6.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"knip": "6.48.0",
		"prettier": "3.10.1",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"pretty-quick": "4.2.2",
		"release-it": "21.1.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.74.0",
		"vitest": "5.1.0"
	},
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": ">=22"
	}
}
