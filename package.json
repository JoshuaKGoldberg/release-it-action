{
	"name": "release-it-action",
	"version": "0.6.4",
	"description": "Runs release-it as a GitHub Action, with handling for semantic releases and protected branches. 📤",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/release-it-action.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": "./lib/index.js",
	"main": "lib/index.js",
	"files": [
		"lib/",
		"!lib/action/"
	],
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"build:release": "rm -rf dist && ncc build src/action/index.ts -o dist",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "knip",
		"lint:md": "markdownlint \"**/*.md\" \".github/**/*.md\" --rules markdownlint-sentences-per-line",
		"lint:packages": "pnpm dedupe --check",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"prepublishOnly": "rm -rf lib && pnpm build",
		"test": "vitest",
		"tsc": "tsc --noEmit"
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"dependencies": {
		"@actions/core": "^3.0.0",
		"@actions/github": "^9.0.0",
		"@octokit/types": "^18.0.0",
		"execa": "^10.0.0",
		"shlex": "^3.0.0",
		"should-semantic-release": "^0.3.5"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@release-it/conventional-changelog": "12.0.2",
		"@types/eslint-plugin-markdown": "2.0.2",
		"@types/node": "24.19.0",
		"@vercel/ncc": "0.45.0",
		"@vitest/coverage-v8": "5.0.1",
		"@vitest/eslint-plugin": "1.6.1",
		"console-fail-test": "0.9.0",
		"create-typescript-app": "2.67.0",
		"cspell": "10.3.3",
		"eslint": "10.12.0",
		"eslint-plugin-jsdoc": "65.0.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-markdown": "5.1.0",
		"eslint-plugin-n": "18.4.0",
		"eslint-plugin-package-json": "1.10.1",
		"eslint-plugin-perfectionist": "5.12.0",
		"eslint-plugin-regexp": "3.3.0",
		"eslint-plugin-yml": "3.8.1",
		"husky": "9.1.7",
		"knip": "6.39.0",
		"lint-staged": "17.6.0",
		"markdownlint": "0.41.1",
		"markdownlint-cli": "0.49.1",
		"markdownlint-sentences-per-line": "0.1.7",
		"prettier": "3.9.7",
		"prettier-plugin-curly": "0.4.0",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-sh": "0.20.0",
		"release-it": "21.1.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.1"
	},
	"packageManager": "pnpm@12.9.0",
	"engines": {
		"node": ">=22"
	}
}
